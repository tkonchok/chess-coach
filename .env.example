# Copy values into your shell or Railway variables. Flask does not auto-load this file.
APP_ORIGIN=http://127.0.0.1:5050
SECRET_KEY=replace-with-a-random-secret
DATABASE=instance/chess-coach.sqlite3
STOCKFISH_PATH=stockfish
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
## Public AI walkthroughs remain disabled until the teaching-quality review.
## LOCAL_TESTING=1 allows local sample review without enabling public release.
WALKTHROUGH_AI_ENABLED=0
# Local demo cannot run with a public APP_ORIGIN.
LOCAL_DEMO=1
# Keep 0 until the teaching-quality release gate is reviewed.
AUTOMATIC_EXERCISES_ENABLED=0

# Localhost-only: 20 analyses and 20 imports per account/day; public default remains 1.
LOCAL_TESTING=0
